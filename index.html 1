            height: 180px;
            background: linear-gradient(135deg, #0a4d68 0%, #088395 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
        }

        .blog-content {
            padding: 20px;
        }

        .blog-content h3 {
            margin-bottom: 10px;
        }

        .blog-content p {
            color: #666;
            font-size: 14px;
        }

        .faq-item {
            background: white;
            margin-bottom: 20px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .faq-question {
            background: #f0f8ff;
            padding: 20px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.3s;
        }

        .faq-question:hover {
            background: #e0f0ff;
        }

        .faq-answer {
            padding: 20px;
            color: #666;
            display: none;
        }

        .faq-answer.active {
            display: block;
        }

        .contact {
            background: linear-gradient(135deg, #0a4d68 0%, #088395 100%);
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        .contact h2 {
            color: white;
        }

        .contact p {
            font-size: 18px;
            margin-bottom: 30px;
        }

        .contact-methods {
