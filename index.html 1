            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .destination-card h3 {
            margin-bottom: 15px;
            font-size: 20px;
        }

        .destination-card p {
            color: #666;
            font-size: 14px;
            line-height: 1.8;
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .testimonial-card {
            background: white;
            padding: 30px;
            border-radius: 10px;
